SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
# starttls (587), ssl (465), or none (local SMTP only)
SMTP_SECURITY=starttls
# Gmail account used to authenticate and send mail
SMTP_USER=your-email@gmail.com
# Google App Password (16 characters), NOT your Gmail login password
SMTP_PASSWORD=your-app-password
# Use SMTP_USER or an authorized Gmail Send mail as alias
SMTP_FROM=your-email@gmail.com
# Test inbox; plus aliases are supported, e.g. your-email+etransfer@gmail.com
SMTP_TO=your-test-inbox@example.com
# Optional: leave blank to use SMTP_FROM
SMTP_REPLY_TO=
